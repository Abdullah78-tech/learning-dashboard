APP_NAME="Learning Dashboard"
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
BASE_URL=http://localhost:8000
SECURE_COOKIES=false
# Quick local start. To use PostgreSQL, replace with the second example.
DATABASE_URL=sqlite:///./learning.db
# DATABASE_URL=postgresql+psycopg://dashboard:YOUR_PASSWORD@localhost:5432/learning_dashboard
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use an app password if your personal email is Gmail, never your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
